{
  "expo": {
    "name": "Hora do Remédio",
    "slug": "hora-do-remedio",
    "version": "1.0.0",
    "scheme": "horadoremedio",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios"
    ],
    "ios": {
      "bundleIdentifier": "com.dablab.horadoremedio",
      "supportsTablet": false,
      "requireFullScreen": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-localization",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F2F2F7",
          "image": "./assets/icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          }
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a16ba7d5-4e95-4f1f-b544-099215e54a14"
      }
    },
    "owner": "alexsiq"
  }
}
