        "ck_remedios_nome_nao_vazio": {
          "name": "ck_remedios_nome_nao_vazio",
          "value": "length(trim(\"remedios\".\"nome\")) BETWEEN 1 AND 60"
        },
        "ck_remedios_forma": {
          "name": "ck_remedios_forma",
          "value": "\"remedios\".\"forma\" IN ('comprimido', 'capsula', 'gotas', 'xarope', 'injecao', 'pomada', 'spray', 'outro')"
        },
        "ck_remedios_frequencia": {
          "name": "ck_remedios_frequencia",
          "value": "\"remedios\".\"frequencia\" IN ('diario', 'dias_semana', 'intervalo_dias', 'quando_precisar')"
        },
        "ck_remedios_cor": {
          "name": "ck_remedios_cor",
          "value": "\"remedios\".\"cor\" IN ('coral', 'azul', 'verde', 'amarelo', 'lilas', 'pessego')"
        },
        "ck_remedios_intervalo_coerente": {
          "name": "ck_remedios_intervalo_coerente",
          "value": "(\"remedios\".\"frequencia\" = 'intervalo_dias' AND \"remedios\".\"intervalo_dias\" BETWEEN 2 AND 30) OR (\"remedios\".\"frequencia\" <> 'intervalo_dias' AND \"remedios\".\"intervalo_dias\" IS NULL)"
        },
        "ck_remedios_dias_semana_coerente": {
          "name": "ck_remedios_dias_semana_coerente",
          "value": "(\"remedios\".\"frequencia\" = 'dias_semana' AND \"remedios\".\"dias_semana\" GLOB '[1-7]*' AND length(\"remedios\".\"dias_semana\") BETWEEN 1 AND 7) OR (\"remedios\".\"frequencia\" <> 'dias_semana' AND \"remedios\".\"dias_semana\" IS NULL)"
        },
        "ck_remedios_lembrete_ativo": {
          "name": "ck_remedios_lembrete_ativo",
